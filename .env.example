# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GITHUB_TOKEN: GitHub Personal Access Token (repo + workflow scope) for reading repositories and creating Draft PRs.
GITHUB_TOKEN="ghp_your_github_token"

# CLOUDFLARE_API_TOKEN: Cloudflare API Token with Workers Scripts, Workflows, and KV Namespaces read permissions.
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# CLOUDFLARE_ACCOUNT_ID: Cloudflare Account ID for inspecting Workers, Workflows, and KV Namespaces.
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTODEV_EDIT_PASSWORD: Optional server-side password to unlock edit/mutation operations (overrides stored hash and default).
AUTODEV_EDIT_PASSWORD=

# Feishu (Lark) Bot Integration — server-side secrets only
# App ID & App Secret from Feishu Open Platform (Credentials & Basic Info)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Verification Token from Feishu Event Subscriptions / Card Callback settings
FEISHU_VERIFICATION_TOKEN=
# Optional Encrypt Key (recommended) for AES-256-CBC callback decryption & X-Lark-Signature verification
FEISHU_ENCRYPT_KEY=
# Optional default group chat_id (oc_xxx) for proactive stage completion cards (auto-remembers latest @mention chat if omitted)
FEISHU_DEFAULT_CHAT_ID=
# Optional comma-separated allowlist of Feishu chat_ids permitted to trigger pipeline actions
FEISHU_ALLOWED_CHAT_IDS=

