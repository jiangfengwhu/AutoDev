# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GITHUB_TOKEN: GitHub Personal Access Token (repo + workflow scope) for reading repositories and creating Draft PRs.
GITHUB_TOKEN="ghp_your_github_token"

# CLOUDFLARE_API_TOKEN: Cloudflare API Token with Workers Scripts, Workflows, and KV Namespaces read permissions.
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# CLOUDFLARE_ACCOUNT_ID: Cloudflare Account ID for inspecting Workers, Workflows, and KV Namespaces.
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
