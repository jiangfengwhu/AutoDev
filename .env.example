# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GITHUB_TOKEN: GitHub Personal Access Token (repo + workflow scope) for reading repositories, creating Draft PRs, and auto-deriving signals secrets.
GITHUB_TOKEN="ghp_your_github_token"

# CLOUDFLARE_API_TOKEN: Cloudflare API Token with Workers Scripts, D1, and KV permissions.
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# CLOUDFLARE_ACCOUNT_ID: Cloudflare Account ID.
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Feishu (Lark) Bot Integration — required server-side secrets only
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# SHUSHENG_APIKEY: 书生·端砚科学发现平台 (https://discovery-api.intern-ai.org.cn/v1) API Key（默认备用推理引擎）
SHUSHENG_APIKEY=
